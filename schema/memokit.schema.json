{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/tsrmehmet/memokit/main/schema/memokit.schema.json",
  "title": "memokit project configuration",
  "type": "object",
  "required": [
    "version",
    "project"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "tag"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Shown in the session-start header."
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$",
          "description": "Message tag, e.g. ABC → [ABC-KURAL]."
        }
      }
    },
    "language": {
      "enum": [
        "en",
        "tr"
      ],
      "default": "en"
    },
    "guardedDirs": {
      "type": "array",
      "minItems": 1,
      "default": [
        "src",
        "tests"
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
      },
      "description": "Repo-relative directories the main session may not write to."
    },
    "contextBudget": {
      "type": "object",
      "properties": {
        "limitTokens": {
          "type": "integer",
          "minimum": 1000,
          "default": 300000
        }
      }
    },
    "stateStale": {
      "type": "object",
      "properties": {
        "maxCommitsBehind": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        }
      }
    },
    "sessionStart": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\"path — description\" lines shown at session start."
        },
        "healthScript": {
          "type": "string",
          "description": "Repo-relative script run with --fast at session start; not run when it resolves outside the project root or is a symlink."
        }
      }
    },
    "hints": {
      "type": "object",
      "properties": {
        "builtin": {
          "type": "array",
          "items": {
            "enum": [
              "debugging",
              "decision",
              "review",
              "handoff",
              "resume",
              "graphify"
            ]
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "match",
              "text"
            ],
            "properties": {
              "match": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "root"
      ],
      "description": "Code graph (graphify). Present = enabled: the handoff refreshes it and the codebase-question hint reports its staleness.",
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*)$",
          "description": "Repo-relative directory the graph covers (\".\" = whole repo). Must match the directory the graph was built from."
        },
        "maxCommitsBehind": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "Commits under root since the last refresh before the hint says to refresh before answering."
        },
        "refreshScript": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
          "description": "Repo-relative script that replaces the builtin refresh (run from the repo root; exit 0 = refreshed); not run when it resolves outside the project root or is a symlink."
        }
      }
    },
    "scratch": {
      "type": "object",
      "additionalProperties": false,
      "description": "Temp-space hygiene for agent scratch directories.",
      "properties": {
        "agentMaxMB": { "type": "integer", "minimum": 1, "default": 1024, "description": "New scratchpad files (MB) a subagent may leave behind; at or above it the SubagentStop gate blocks the subagent from returning." },
        "staleAfterHours": { "type": "integer", "minimum": 1, "default": 24, "description": "Hours after which scratch data counts as stale." },
        "reportMinMB": { "type": "integer", "minimum": 0, "default": 500, "description": "Minimum total scratch size (MB) worth reporting." }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "description": "Free-disk-space guard.",
      "properties": {
        "minFreeGB": { "type": "integer", "minimum": 0, "default": 30, "description": "Free space (GB) below which memokit warns." },
        "dropWarnGB": { "type": "integer", "minimum": 1, "default": 10, "description": "Free-space drop (GB) during a single Bash command that triggers a warning." }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "description": "Limits for parallel wave execution.",
      "properties": {
        "maxCoders": { "type": "integer", "minimum": 1, "default": 3, "description": "Maximum coder subagents running at once." },
        "maxReviewers": { "type": "integer", "minimum": 1, "default": 3, "description": "Maximum reviewer subagents running at once." }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reviewer settings.",
      "properties": {
        "model": { "enum": ["auto", "opus", "sonnet"], "default": "auto", "description": "Reviewer model: auto picks by risk." }
      }
    },
    "careful": {
      "type": "object",
      "description": "Destructive-command guard. Project patterns are added to the builtin set; they can only add, never remove.",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "match",
              "label"
            ],
            "properties": {
              "match": {
                "type": "string",
                "minLength": 1,
                "description": "POSIX ERE (grep -E), case-insensitive, matched against the whole command text."
              },
              "label": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                "description": "Short name shown in the deny message."
              }
            }
          }
        }
      }
    }
  }
}
