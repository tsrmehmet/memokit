{
  "$schema": "https://raw.githubusercontent.com/tsrmehmet/memokit/main/schema/memokit.schema.json",
  "version": 1,
  "project": { "name": "Acme Shop", "tag": "ACME" },
  "language": "en",
  "guardedDirs": ["src", "tests", "web"],
  "contextBudget": { "limitTokens": 300000 },
  "stateStale": { "maxCommitsBehind": 3 },
  "sessionStart": {
    "docs": ["docs/ROADMAP.md — roadmap and locked decisions"],
    "healthScript": "scripts/knowledge-health.sh"
  },
  "hints": {
    "builtin": ["debugging", "decision", "review", "handoff", "resume", "graphify"],
    "custom": [ { "match": "mockup|react|tailwind", "text": "Frontend work → frontend-design skill." } ]
  },
  "graph": { "root": "src", "maxCommitsBehind": 20 },
  "scratch": { "agentMaxMB": 1024, "staleAfterHours": 24, "reportMinMB": 500 },
  "disk": { "minFreeGB": 30, "dropWarnGB": 10 },
  "parallel": { "maxCoders": 3, "maxReviewers": 3 },
  "review": { "model": "auto" },
  "careful": {
    "patterns": [ { "match": "kubectl[[:space:]]+(apply|patch|scale)", "label": "kubectl-mutate" } ]
  }
}
